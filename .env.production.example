POSTGRES_ADMIN_URL=postgresql://saju_admin:ADMIN_PASSWORD@saju-db:5432/postgres
POSTGRES_URL=postgresql://saju:GENERATED_HEX_PASSWORD@saju-db:5432/saju
DB_POOL_SIZE=10

CAFE24_LLM_API_KEY=
CAFE24_LLM_API_KEYS=
CAFE24_LLM_KEY_LABELS=primary,backup-1,backup-2
CAFE24_LLM_MODEL=cafe24/auto
# cafe24/auto often routes the long JSON reading to a model that drops fields.
CAFE24_LLM_EPIC_MODEL=google/gemini-2.5-flash
CAFE24_LLM_BASE_URL=
CAFE24_LLM_REASONING_EFFORT=none

HTTP_PORT=19100
BACKEND_HTTP_PORT=19101

AUTH_BASE_URL=https://saju.ashwoodfriends.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_B64=

TOSS_API_BASE=https://apps-in-toss-api.toss.im
TOSS_MTLS_CERT_PATH=/app/secrets/toss/dalbitsaju_public.crt
TOSS_MTLS_KEY_PATH=/app/secrets/toss/dalbitsaju_private.key
TOSS_MTLS_KEY_PASSWORD=
TOSS_LOGIN_MOCK=false
TOSS_IAP_ENABLED=false
# Exact miniapp origins only. '*' disables the Origin (CSRF) check for every API.
TOSS_ALLOWED_ORIGINS=https://dalbitsaju.apps.tossmini.com,https://dalbitsaju.private-apps.tossmini.com,https://dalbitsaju.web.tossmini.com,https://dalbitsaju.private-web.tossmini.com
