# Node web server
PORT=3000
HOST=0.0.0.0

# Local development journal directory. Production uses DATABASE_URL.
DALBIT_DATA_DIR=.data

# Cafe24 LLM Router (server only; never expose this value to the browser)
CAFE24_LLM_API_KEY=
# Optional comma-separated fallback keys and safe log labels.
CAFE24_LLM_API_KEYS=
CAFE24_LLM_KEY_LABELS=
CAFE24_LLM_MODEL=cafe24/auto

# Optional custom router endpoint. Leave empty for the built-in Cafe24 endpoint.
CAFE24_LLM_BASE_URL=

# Production PostgreSQL backend
DATABASE_URL=
DB_POOL_SIZE=10
