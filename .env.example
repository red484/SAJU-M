# Node web server
PORT=3000
HOST=0.0.0.0

# Local development journal directory. Production uses DATABASE_URL.
DALBIT_DATA_DIR=.data

# Cafe24 LLM Router (server only; never expose this value to the browser)
CAFE24_LLM_API_KEY=
# Optional comma-separated fallback keys and safe log labels.
CAFE24_LLM_API_KEYS=
CAFE24_LLM_KEY_LABELS=
CAFE24_LLM_MODEL=cafe24/auto

# Optional custom router endpoint. Leave empty for the built-in Cafe24 endpoint.
CAFE24_LLM_BASE_URL=

# Production PostgreSQL backend
DATABASE_URL=
DB_POOL_SIZE=10

# Mobile web social login. Callback URLs:
#   ${AUTH_BASE_URL}/api/auth/callback/google
#   ${AUTH_BASE_URL}/api/auth/callback/apple
AUTH_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM with literal \n characters is accepted.
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_B64=

# Apps in Toss login. The certificate and private key are issued in the Toss console.
TOSS_API_BASE=https://apps-in-toss-api.toss.im
TOSS_MTLS_CERT_PATH=/app/secrets/toss/dalbitsaju_public.crt
TOSS_MTLS_KEY_PATH=/app/secrets/toss/dalbitsaju_private.key
TOSS_MTLS_KEY_PASSWORD=
TOSS_LOGIN_MOCK=false
# Comma-separated miniapp origins. Use * only when the Toss runtime origin is not fixed.
TOSS_ALLOWED_ORIGINS=*
